# Copy this file to .env and adjust the values.
# Everything is optional - the server runs fine with no .env at all.

# Port the server listens on (default: 3000)
# PORT=3000

# ngrok authtoken, required for online multiplayer.
# Get one at https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=

# Set to false to keep the server local-only even when NGROK_AUTHTOKEN is set.
# NGROK_ENABLED=false
